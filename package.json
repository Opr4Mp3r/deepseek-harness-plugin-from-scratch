{
  "name": "deepseek-harness-plugin-from-scratch",
  "version": "0.1.0",
  "description": "A code-audited, progressive guide to building production-grade DeepSeek Harness plugins.",
  "keywords": [
    "deepseek",
    "harness",
    "cordis",
    "plugin",
    "tutorial"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Opr4Mp3r/deepseek-harness-plugin-from-scratch.git"
  },
  "homepage": "https://github.com/Opr4Mp3r/deepseek-harness-plugin-from-scratch#readme",
  "bugs": {
    "url": "https://github.com/Opr4Mp3r/deepseek-harness-plugin-from-scratch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:package",
    "build:package": "tsc -p tsconfig.build.json && node scripts/strip-checkpoint-comments.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && pnpm test && pnpm run smoke:source && pnpm run smoke:loader && pnpm run check:checkpoints && pnpm run check:docs && pnpm run check:preview && pnpm run check:package",
    "check:checkpoints": "node --import tsx scripts/verify-checkpoints.ts",
    "check:docs": "node --import tsx scripts/verify-docs.ts",
    "check:package": "node --import tsx examples/testing/acceptance/package.ts",
    "check:preview": "node --import tsx scripts/verify-preview.mjs",
    "check:profile": "node examples/testing/acceptance/profile.mjs",
    "generate:checkpoints": "node --import tsx scripts/generate-checkpoints.ts",
    "preview": "node --import tsx preview/server.mjs . 4175",
    "prepare": "tsc -p tsconfig.build.json && node scripts/strip-checkpoint-comments.mjs",
    "smoke:loader": "node --import tsx examples/testing/acceptance/entrypoints.ts",
    "smoke:source": "node --import tsx examples/testing/acceptance/loader-runner.mjs examples/testing/cordis.yml 'Acceptance, Ada!'",
    "test": "pnpm run build:package && vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "22.20.0",
    "marked": "16.4.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
